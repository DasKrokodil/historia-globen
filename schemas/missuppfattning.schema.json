{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historia-globen: missuppfattningar (#838)",
  "type": "object",
  "required": ["schema", "misconceptions"],
  "properties": {
    "schema": { "type": "string", "pattern": "^historia-globen/missuppfattningar@1$" },
    "note": { "type": "string" },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "truth", "origin", "originKinds", "sources", "review"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "events": { "type": "array", "items": { "type": "string", "pattern": ".+" } },
          "year": { "type": "integer" },
          "location": { "type": "object", "required": ["type", "coordinates"] },
          "locationPrecision": { "type": "string", "enum": ["region", "country"] },
          "claim": { "type": "object", "required": ["sv"], "properties": { "sv": { "type": "string", "pattern": ".+" } } },
          "truth": { "type": "object", "required": ["sv"], "properties": { "sv": { "type": "string", "pattern": ".+" } } },
          "origin": { "type": "object", "required": ["sv"], "properties": { "sv": { "type": "string", "pattern": ".+" } } },
          "originKinds": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["satire", "propaganda", "misreading", "media", "folk", "other"] } },
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": ".+" } },
          "review": { "type": "string", "enum": ["draft", "source-checked", "two-sources"] }
        }
      }
    }
  }
}

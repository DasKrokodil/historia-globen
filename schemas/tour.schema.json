{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historia-globen: en guidad tur (#47)",
  "type": "object",
  "required": ["schema", "version", "id", "title", "review", "steps"],
  "properties": {
    "schema": { "type": "string", "pattern": "^historia-globen/tur@1$" },
    "version": { "type": "integer", "minimum": 1, "maximum": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "$ref": "#/$defs/text" },
    "summary": { "$ref": "#/$defs/text" },
    "war": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "empire": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "group": { "type": "string", "enum": ["kallkritik", "krig", "tid", "fall"] },
    "review": { "type": "string", "enum": ["draft", "source-checked", "two-sources"] },
    "lesson": { "$ref": "#/$defs/lesson" },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "lesson": {
      "type": "object",
      "required": ["grades", "minutes", "curriculum", "teacher", "exitTicket"],
      "properties": {
        "grades": { "type": "string", "enum": ["F-3", "4-6", "7-9", "gy"] },
        "minutes": { "type": "integer", "minimum": 10, "maximum": 120 },
        "curriculum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["text", "sources"],
            "properties": {
              "text": { "$ref": "#/$defs/text" },
              "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        "prerequisites": { "$ref": "#/$defs/text" },
        "teacher": { "$ref": "#/$defs/text" },
        "exitTicket": { "$ref": "#/$defs/text" },
        "exitAnswer": { "$ref": "#/$defs/answer" },
        "glossary": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["term", "text", "sources"],
            "properties": {
              "term": { "$ref": "#/$defs/text" },
              "text": { "$ref": "#/$defs/text" },
              "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        "sourceDetective": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["event", "questions"],
            "properties": {
              "event": { "type": "string" },
              "questions": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/text" } }
            }
          }
        },
        "lock": {
          "type": "object",
          "properties": {
            "years": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } },
            "layers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "escape": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      }
    },
    "answer": {
      "type": "object",
      "required": ["text", "sources"],
      "properties": {
        "text": { "$ref": "#/$defs/text" },
        "sources": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "text": {
      "type": "object",
      "required": ["sv"],
      "properties": { "sv": { "type": "string", "pattern": "\\S" }, "en": { "type": "string" }, "fr": { "type": "string" }, "de": { "type": "string" }, "es": { "type": "string" } }
    },
    "step": {
      "type": "object",
      "required": ["id", "at", "camera", "text", "layers", "sources"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "at": { "type": "number" },
        "camera": {
          "type": "object",
          "required": ["lat", "lon", "zoom"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 },
            "zoom": { "type": "number", "minimum": 0.8, "maximum": 3.2 }
          }
        },
        "title": { "$ref": "#/$defs/text" },
        "chapter": { "$ref": "#/$defs/text" },
        "question": { "$ref": "#/$defs/text" },
        "answer": { "$ref": "#/$defs/answer" },
        "status": { "type": "string", "enum": ["belagt", "omtvistat", "okant"] },
        "text": { "$ref": "#/$defs/text" },
        "layers": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
        "open": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "place": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "image": {
          "type": "object",
          "required": ["file", "kind", "caption", "credit", "license", "source"],
          "properties": {
            "file": { "type": "string", "pattern": "^images/turer/[a-z0-9-]+\\.webp$" },
            "kind": { "type": "string", "enum": ["photo", "illustration"] },
            "caption": { "$ref": "#/$defs/text" },
            "credit": { "type": "string" },
            "license": { "type": "string" },
            "source": { "type": "string" }
          }
        },
        "partLabels": { "type": "array", "items": { "type": ["string", "null"], "pattern": "^[A-Za-z][A-Za-z0-9-]*$" } },
        "mark": {
          "type": "object",
          "required": ["label"],
          "properties": {
            "label": { "$ref": "#/$defs/text" },
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lon": { "type": "number", "minimum": -180, "maximum": 180 },
            "approx": { "type": "boolean" }
          }
        },
        "line": {
          "type": "object",
          "required": ["file", "label", "source"],
          "properties": {
            "file": { "type": "string", "pattern": "^data/turer/linjer/[a-z0-9-]+\\.json$" },
            "label": { "$ref": "#/$defs/text" },
            "source": { "type": "string" }
          }
        },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

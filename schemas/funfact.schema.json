{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historia-globen: fun facts",
  "type": "object",
  "required": ["schema", "near", "funfacts"],
  "properties": {
    "schema": { "type": "string", "pattern": "^historia-globen/funfacts@1$" },
    "notes": { "type": "string" },
    "near": {
      "description": "Hur många år nära i tid får vara (#1311): raden väljs efter året där avståndet börjar, den första vars until (astronomiskt år) är minst det året, annars den sista utan until.",
      "type": "array", "minItems": 1,
      "items": { "type": "object", "required": ["years"], "properties": { "until": { "type": "integer" }, "years": { "type": "integer", "minimum": 1 } } }
    },
    "funfacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "events", "show", "review", "relation", "text"],
        "properties": {
          "id": { "type": "string", "pattern": ".+" },
          "events": { "type": "array", "items": { "type": "string", "pattern": ".+" } },
          "show": { "type": "array", "items": { "type": "integer" } },
          "review": { "type": "string", "enum": ["draft", "source-checked", "two-sources"] },
          "relation": { "description": "Relationen i tid (#1311): together = pågår minst ett gemensamt år, near = nära i tid, apart = jämför avstånd i tid. Räknas fram ur årtalen (js/samtidighet.js).", "type": "string", "enum": ["together", "near", "apart"] },
          "text": { "type": "object", "required": ["sv"], "properties": { "sv": { "type": "string", "pattern": ".+" } } }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historia-globen: bildlager, rader i Lager med tidsskivor (#54, #1325)",
  "type": "object",
  "required": ["schema", "layers"],
  "properties": {
    "schema": { "type": "string", "pattern": "^historia-globen/bildlager@2$" },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "slices"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "kind": { "type": "string", "enum": ["lager", "grund"] },
          "aliases": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "group": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "$ref": "#/$defs/text" },
          "note": { "$ref": "#/$defs/text" },
          "label": { "$ref": "#/$defs/text" },
          "slices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "format", "file", "from", "sources", "review", "license"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "title": { "$ref": "#/$defs/text" },
                "format": { "type": "string", "enum": ["raster", "vektor"] },
                "file": { "type": "string", "pattern": "^(images|data)/[A-Za-z0-9_./-]+\\.(jpg|jpeg|png|webp|json)$" },
                "width": { "type": "integer", "minimum": 1, "maximum": 4096 },
                "height": { "type": "integer", "minimum": 1, "maximum": 4096 },
                "from": { "type": "integer" },
                "to": { "type": "integer" },
                "bounds": { "type": "array", "minItems": 4, "items": { "type": "number", "minimum": -180, "maximum": 180 } },
                "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
                "caveat": { "$ref": "#/$defs/text" },
                "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": ".+" } },
                "review": { "type": "string", "enum": ["draft", "source-checked", "two-sources"] },
                "license": { "type": "string", "pattern": ".+" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "required": ["sv", "en", "de", "es", "fr"],
      "properties": {
        "sv": { "type": "string", "pattern": ".+" }, "en": { "type": "string", "pattern": ".+" }, "de": { "type": "string", "pattern": ".+" },
        "es": { "type": "string", "pattern": ".+" }, "fr": { "type": "string", "pattern": ".+" }
      }
    }
  }
}

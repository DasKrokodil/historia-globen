{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historia-globen: platser (#579)",
  "type": "object",
  "required": ["schema", "places"],
  "properties": {
    "schema": { "type": "string", "pattern": "^historia-globen/platser@1$" },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "intro", "view", "boundary", "sources", "review"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "type": { "enum": ["autonomous", "country", "landskap"], "description": "Typen visas som en egen rad på kortet; ui() har place.type.<typ> på alla språk." },
          "name": { "$ref": "#/$defs/text" },
          "partOf": { "$ref": "#/$defs/text" },
          "intro": { "$ref": "#/$defs/text" },
          "view": {
            "type": "object",
            "required": ["center", "zoom"],
            "properties": {
              "center": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
              "zoom": { "type": "number", "minimum": 1, "maximum": 6 }
            }
          },
          "boundary": {
            "type": "object",
            "required": ["source", "geometry", "neighbourKm", "neighbours"],
            "oneOf": [{ "required": ["ne"] }, { "required": ["admin1"] }],
            "properties": {
              "source": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "ne": { "type": "string", "pattern": "^[0-9]+$", "description": "Land: ISO 3166-1 numeriskt id i Natural Earth (tools/platser_gransar.py)." },
              "admin1": { "type": "string", "pattern": "^[A-Z]{3}-[0-9]+$", "description": "Län eller delstat: adm1_code i Natural Earth 1:10m admin 1." },
              "note": { "$ref": "#/$defs/text", "description": "Extra rad på kortet om vad konturen är, när den inte är platsens egen gräns (länet för landskapet Skåne)." },
              "exclude": { "type": "array", "items": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } } },
              "geometry": {
                "type": "object",
                "required": ["type", "coordinates"],
                "properties": { "type": { "enum": ["Polygon", "MultiPolygon"] }, "coordinates": { "type": "array", "minItems": 1 } }
              },
              "neighbourKm": { "type": "number", "minimum": 20, "description": "Hur många km från gränsen grannländerna är kompletta (#1449). Minst kustmarginalen COAST_MARGIN_KM i js/place-geo.js; skrivs av tools/platser_gransar.py." },
              "neighbours": {
                "type": "array",
                "description": "Grannländerna (#1449): andra länders polygoner i Natural Earth admin 0, bara de delar som ligger inom neighbourKm från gränsen. En punkt inom kustmarginalen som ligger inne i en av dem hör inte till platsen. Platsens eget land är inte med. Tom lista om inget land ligger så nära. Skrivs av tools/platser_gransar.py, redigeras inte.",
                "items": {
                  "type": "object",
                  "required": ["name", "geometry"],
                  "additionalProperties": false,
                  "properties": {
                    "name": { "type": "string", "pattern": ".+", "description": "Landets namn i Natural Earth (engelska), bara för den som läser filen." },
                    "ne": { "type": "string", "pattern": "^[0-9]+$", "description": "ISO 3166-1 numeriskt id i Natural Earth; saknas för länder utan id (Kosovo)." },
                    "geometry": {
                      "type": "object",
                      "required": ["type", "coordinates"],
                      "properties": { "type": { "enum": ["Polygon", "MultiPolygon"] }, "coordinates": { "type": "array", "minItems": 1 } }
                    }
                  }
                }
              }
            }
          },
          "emblems": {"type": "array", "description": "Flagga och vapen på kortet (#1160): en egen SVG i img/flags/, bildtext på alla språk, kredit, licens och källa (filsidan i sources.json).", "items": {"type": "object", "required": ["kind", "file", "caption", "credit", "license", "source"], "additionalProperties": false, "properties": {"kind": {"enum": ["flag", "arms"]}, "file": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "caption": {"type": "object", "required": ["sv"]}, "credit": {"type": "string"}, "license": {"type": "string"}, "source": {"type": "string"}}}},
          "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "review": { "enum": ["draft", "source-checked", "two-sources"] },
          "placeholder": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "required": ["sv", "en", "de", "es", "fr"],
      "properties": {
        "sv": { "type": "string", "pattern": ".+" }, "en": { "type": "string", "pattern": ".+" }, "de": { "type": "string", "pattern": ".+" },
        "es": { "type": "string", "pattern": ".+" }, "fr": { "type": "string", "pattern": ".+" }
      }
    }
  }
}

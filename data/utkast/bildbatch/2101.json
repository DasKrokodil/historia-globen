      "id": "insulin-forsta-patienten",
      "titel": "Den första insulinbehandlingen",
      "start": 1922,
      "plats": "Toronto General Hospital, Toronto, Kanada",
      "wikidata": null,
      "kandidater": [
        {
          "fil": "File:The Hospital for Sick Children, Toronto, Ontario (29375668624).jpg",
          "filsida": "https://commons.wikimedia.org/wiki/File:The_Hospital_for_Sick_Children,_Toronto,_Ontario_(29375668624).jpg",
